{
    "name": "particle-academy/fancy-chat-prism-php",
    "description": "OPTIONAL Prism Harness adapter for particle-academy/fancy-chat-php: maps a Harness session's RunStep stream (contract g282.1) onto the provider-neutral agent-chat events, drives streamed approval continuation and maps Harness cancel outcomes.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "laravel",
        "agent",
        "chat",
        "prism",
        "prism-harness",
        "human-in-the-loop",
        "fancy",
        "particle-academy"
    ],
    "homepage": "https://github.com/Particle-Academy/fancy-chat-prism-php",
    "support": {
        "issues": "https://github.com/Particle-Academy/fancy-chat-prism-php/issues",
        "source": "https://github.com/Particle-Academy/fancy-chat-prism-php"
    },
    "authors": [
        {
            "name": "Particle Academy",
            "homepage": "https://github.com/Particle-Academy"
        }
    ],
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/Particle-Academy/fancy-chat-php.git"
        }
    ],
    "require": {
        "php": "^8.4",
        "illuminate/contracts": "^13.0",
        "illuminate/support": "^13.0",
        "particle-academy/fancy-chat-php": "dev-main",
        "particle-academy/prism-harness": "^0.26"
    },
    "require-dev": {
        "laravel/framework": "^13.30",
        "particle-academy/prism-graph": "^0.3",
        "pestphp/pest": "^5.0"
    },
    "suggest": {
        "particle-academy/prism-graph": "^0.3, for the optional KnowledgeBridge (the knowledge explorer's routes)"
    },
    "autoload": {
        "psr-4": {
            "FancyChat\\Prism\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "FancyChat\\Prism\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "pest"
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        },
        "sort-packages": true
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
